{
  "name": "mynotes",
  "productName": "MyNotes",
  "version": "1.2.1",
  "description": "MyNotes - Personal Knowledge & Document Workspace",
  "author": {
    "name": "Shaik"
  },
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bundle:mac": "tauri build --bundles dmg,app",
    "bundle:dmg": "tauri build --bundles dmg",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "validate": "npm run typecheck && npm run typecheck:worker && npm run lint && npm test && npm run build"
  },
  "dependencies": {
