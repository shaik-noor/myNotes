# =====================================================================
# myNotes Google Drive Cloud Sync
# =====================================================================
#
# Google OAuth goes through the Cloudflare Worker auth relay in `worker/`,
# which holds GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as encrypted Cloudflare
# secrets (see worker/README.md). The desktop app never contains them.
#
# Relay URL baked into app builds. Dev builds also read it here at runtime,
# so you can point it at a local relay (http://localhost:8787).
AUTH_SERVER_URL=https://mynotes-auth.<your-subdomain>.workers.dev
